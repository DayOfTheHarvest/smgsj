---
import Base from '../../layouts/Base.astro';
import Carousel from '../../components/Carousel.astro';
import ActionCards from '../../components/ActionCards.astro';
import Icon from '../../components/Icon.astro';
import OfficeSection from '../../components/OfficeSection.astro';
import FlocknoteSignup from '../../components/FlocknoteSignup.astro';
import MassCards from '../../components/MassCards.astro';
import { EXTERNAL, resolveLink, type Lang } from '../../config';
import homepageData from '../../data/homepage.json';
import { renderMd } from '../../lib/md';
import { getCollection } from 'astro:content';
import en from '../../data/ui.en.json';
import es from '../../data/ui.es.json';
import vi from '../../data/ui.vi.json';

export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }, { params: { lang: 'vi' } }];
}
const { lang } = Astro.params as { lang: Lang };
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
const pages = await getCollection('pages');
const home = pages.find((p) => p.slug === 'home');
const bodyEn = home?.body ?? '';
const bodyLoc = ((home?.data as any)?.[`body_${lang}`] as string)?.trim();
const fallback = lang !== 'en' && !bodyLoc;
const body = renderMd(lang === 'en' ? bodyEn : (bodyLoc || bodyEn));
const titleVal = ((home?.data as any)?.[`title_${lang}`] as string)?.trim()
  || home?.data.title_en || ui.hero.welcome;
const homepage = homepageData as any;
const pastorQuote: string = homepage.pastor_quote || '';
const events = (homepage.events as Array<any>) ?? [];
const hero = (homepage.hero as any) ?? {};
const heroButtons = (hero.buttons as Array<any>) ?? [];
const facility = (homepage.facility as any) ?? {};
const catholic = (homepage.catholic as any) ?? {};
const icons = (catholic.icons as Array<any>) ?? [];
const customs = (((homepage.custom as Array<any>) ?? []) as Array<any>).map((b: any) => ({
  ...(b as object),
  cards: ((b as any).cards as Array<any>) ?? [],
}));
const t = (obj: any): string => obj?.[lang] || obj?.en || '';
const btnClassFor = (s: string) =>
  s === 'gold' ? 'btn btn-gold' : s === 'primary' ? 'btn btn-primary' : s === 'outline' ? 'btn btn-outline' : 'btn btn-light';
const hrefFor = (link: string) => resolveLink(link, lang);
// Staff-ordered sections (Decap: Homepage welcome → Page layout). Unknown ids
// ignored; missing ids appended in default position; hidden ids skipped.
const DEFAULT_ORDER = ['carousel', 'hero', 'actions', 'schedule', 'events', 'custom', 'body', 'office', 'flocknote', 'catholic'];
const layout = (homepage.layout as any) ?? {};
const hidden = new Set((layout.hidden as string[]) ?? []);
const ordered = ((layout.order as string[]) ?? []).filter((id) => DEFAULT_ORDER.includes(id) && !hidden.has(id));
for (const id of DEFAULT_ORDER) {
  if (!ordered.includes(id) && !hidden.has(id)) ordered.push(id);
}
---
<Base lang={lang} slug="home" title={typeof titleVal === 'string' ? titleVal : ui.hero.welcome} fallback={false}>
  {ordered.map((id) => (
    <>
      {id === 'carousel' && <Carousel lang={lang} ui={ui} />}
      {id === 'hero' && (
        <section class="hero" aria-label="Welcome">
          {hero.eyebrow ? <p class="hero-eyebrow">{hero.eyebrow}</p> : null}
          <h1>{t(hero.title) || ui.hero.welcome}</h1>
          <p>{t(hero.subtitle) || ui.hero.subtitle}</p>
          <p class="pastor">{pastorQuote}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {heroButtons.map((b) => (
              <a class={btnClassFor(b.style)} href={hrefFor(b.link)}>{t(b.label)}</a>
            ))}
          </div>
        </section>
      )}
      {id === 'actions' && <ActionCards lang={lang} ui={ui} />}
      {id === 'schedule' && (
        <>
          <MassCards lang={lang} ui={ui} compact />
          <p class="mt-5 flex flex-wrap justify-start gap-2">
            <a class="btn btn-primary px-8 text-lg" href={`/${lang}/mass-times/`}>{ui.schedule.seeAll} →</a>
            <a class="btn btn-outline" href={EXTERNAL.youtube}>▶ {ui.schedule.stream}: @smgsjca</a>
          </p>
        </>
      )}
      {id === 'events' && (
        <section aria-label="Events">
          <h2>{ui.eventsTitle}</h2>
          <div class="cards">
            {events.map((e) => (
              <article class="card">
                {e.icon ? <div class="card-head"><Icon name={e.icon} /><h3>{e.title?.[lang] || e.title?.en}</h3></div> : <h3>{e.title?.[lang] || e.title?.en}</h3>}
                <p>{e.text?.[lang] || e.text?.en}{e.link ? <> <a href={hrefFor(e.link)}>{e.link_label?.[lang] || e.link_label?.en}</a></> : null}</p>
              </article>
            ))}
          </div>
          <p>{t(facility.tail)}</p>
          <p class="flex flex-wrap gap-2">
            <a class="btn btn-primary" href={`/${lang}/calendar/#today`}>{ui.todayEvents}</a>
            <a class="btn btn-outline" href={`/${lang}/calendar/`}>{ui.fullCalendar}</a>
            <a class="btn btn-outline" href={EXTERNAL.calendarSuggest}>{t(facility.link_label)}</a>
          </p>
        </section>
      )}
      {id === 'custom' && customs.length > 0 && customs.map((block, bi) => (
        <section aria-label={t(block.title) || `Section ${bi + 1}`} key={bi}>
          {(block.title?.[lang] || block.title?.en) && <h2>{t(block.title)}</h2>}
          <div class="cards">
            {block.cards.map((c: any) => (
              <article class="card">
                {c.icon ? <div class="card-head"><Icon name={c.icon} /><h3>{c.title?.[lang] || c.title?.en}</h3></div>
                : (c.title?.[lang] || c.title?.en) ? <h3>{c.title?.[lang] || c.title?.en}</h3> : null}
                {c.image?.trim() ? (c.link?.trim()
                  ? <p><a href={hrefFor(c.link.trim())}><img src={c.image} alt={t(c.title) || ''} loading="lazy" style="border-radius:.5rem" /></a></p>
                  : <p><img src={c.image} alt={t(c.title) || ''} loading="lazy" style="border-radius:.5rem" /></p>) : null}
                {(c.text?.[lang] || c.text?.en) && <p>{t(c.text)}</p>}
                {c.link?.trim() ? <p><a class="btn btn-outline" href={hrefFor(c.link.trim())}>{t(c.link_label) || t(c.title)}</a></p> : null}
              </article>
            ))}
          </div>
        </section>
      ))}
      {id === 'body' && body && (
        <section class="prose" data-pagefind-body>
          {fallback && <p class="fallback" data-fallback="en" role="note"><small>{ui.fallbackBanner}</small></p>}
          <div set:html={body} />
        </section>
      )}
      {id === 'office' && <OfficeSection lang={lang} ui={ui} />}
      {id === 'flocknote' && <FlocknoteSignup ui={ui} />}
      {id === 'catholic' && (
        <section class="mb-2 mt-10 text-center" aria-label="Catholic links">
          <div class="flex flex-wrap items-end justify-center gap-10 md:gap-16">
            {icons.map((ic) => (
              <a href={ic.link}><img src={ic.image} alt={ic.alt} width={ic.width || 140} height={ic.height || 140} loading="lazy" /></a>
            ))}
          </div>
          <p class="mx-auto mt-4 text-sm text-soft">{t(catholic.ethics_name)}: <a href={`tel:${EXTERNAL.ethicspoint_phone.replace(/[^0-9]/g, '')}`} class="font-bold">{EXTERNAL.ethicspoint_phone}</a> · <a href={EXTERNAL.ethicspoint}>{t(catholic.ethics_report)}</a></p>
        </section>
      )}
    </>
  ))}
</Base>
