---
import HomePage from '../components/HomePage.astro';
import { getCollection } from 'astro:content';

// Site root serves the English homepage directly — no redirect, no flash.
// ES/VI visitors use the header switcher (their choice is remembered).
const pages = await getCollection('pages');
const home = pages.find((p) => p.slug === 'home');
---
<HomePage lang="en" homeEntry={home} isRoot={true} />
