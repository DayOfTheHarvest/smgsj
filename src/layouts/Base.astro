---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import noticeData from '../data/notice.json';
import '../styles/global.css';
import type { Lang } from '../config';
import { SITE_NAME } from '../config';
import en from '../data/ui.en.json';
import es from '../data/ui.es.json';
import vi from '../data/ui.vi.json';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description?: string;
  fallback?: boolean;
  /** Full canonical path override (the homepage served at / uses '/'). */
  canonicalPath?: string;
}
const { lang, slug, title, description, fallback = false, canonicalPath } = Astro.props;
const ui = lang === 'es' ? es : lang === 'vi' ? vi : en;
const base = import.meta.env.SITE ?? 'https://www.smgsj.org';
const canonical = `${base}${canonicalPath ?? `/${lang}${slug && slug !== 'home' ? '/' + slug : ''}`}`;
const notice = noticeData as any;
const noticeText: string = (notice.text?.[lang] || notice.text?.en || '').trim();
const noticeLabel: string = (notice.link_label?.[lang] || notice.link_label?.en || '').trim();
const showNotice = Boolean(notice.enabled) && noticeText.length > 0;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {SITE_NAME}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={`${base}/en${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="es" href={`${base}/es${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="vi" href={`${base}/vi${slug && slug !== 'home' ? '/' + slug : ''}`} />
  <link rel="alternate" hreflang="x-default" href={`${base}/`} />
  <link rel="icon" href="/favicon.ico" />
  <!-- Netlify Identity: catches invite/recovery tokens site-wide (invite emails
       land on /#invite_token=… with no login code) and forwards to /admin/. -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <!-- Visitor stats: undecided (old GA UA-135786317-1 is dead). Either register for Cloudflare Web Analytics and replace SMGSJ_REPLACE_ME, or swap in a DNS-independent counter. See DEPLOY.md. -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "SMGSJ_REPLACE_ME"}'></script>
</head>
<body>
  <a class="skip" href="#main">{ui.skipLink}</a>
  <Header lang={lang} slug={slug} ui={ui} />
  {showNotice && (
    <div class="notice" role="alert">
      <div class="wrap">
        <strong>{noticeText}</strong>
        {notice.link?.trim() ? <> <a href={notice.link.trim()}>{noticeLabel || notice.link.trim()}</a></> : null}
      </div>
    </div>
  )}
  <main id="main" class="wrap">
    {fallback && <div class="fallback" data-fallback="en" role="note">{ui.fallbackBanner}</div>}
    <slot />
  </main>
  <Footer lang={lang} ui={ui} />
  <script>
    // Invite/recovery tokens are handled strictly AFTER the widget initializes;
    // opening earlier renders an empty overlay. The widget also auto-detects
    // tokens on init — this only guarantees the right modal + /admin landing.
    try {
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function (user) {
          var h = location.hash || '';
          if (!user) {
            if (/invite_token|confirmation_token/.test(h)) window.netlifyIdentity.open('signup');
            else if (/recovery_token|email_change_token/.test(h)) window.netlifyIdentity.open('login');
            window.netlifyIdentity.on('login', function () { document.location.href = '/admin/'; });
          }
        });
      }
    } catch(e) {}
  </script>
</body>
</html>
