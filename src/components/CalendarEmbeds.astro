---
import { EXTERNAL } from '../config';
interface Props { ui: any; }
const { ui } = Astro.props;
---
<p><a class="btn btn-primary" href={EXTERNAL.calendarSuggest}>{ui.facilityRequest}</a></p>
<section aria-label={ui.todayEvents} id="today">
  <h2>{ui.todayEvents}</h2>
  <div class="table-scroll" style="border:0">
    <iframe src={EXTERNAL.today_embed} title={ui.todayEvents} width="100%" height="1000" loading="lazy"></iframe>
  </div>
</section>
<section aria-label={ui.fullCalendar}>
  <h2>{ui.fullCalendar}</h2>
  <div class="table-scroll" style="border:0">
    <iframe src={EXTERNAL.calendar_embed} title={ui.fullCalendar} width="100%" height="1000" loading="lazy"></iframe>
  </div>
  <p><a href={EXTERNAL.calendarView}>{ui.viewFacilities}</a></p>
</section>
