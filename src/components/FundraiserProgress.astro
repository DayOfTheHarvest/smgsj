---
import fundraisersData from '../data/fundraisers.json';
interface Props { ui: any; lang: string; slug: string; }
const { ui, lang, slug } = Astro.props;
// Generic fundraiser thermometer: matches the page slug to a fundraiser entry
// (Decap: Site settings → Fundraisers). Any fundraiser page gets its own
// progress bar + donate button with zero code changes.
const entries = ((fundraisersData as any).fundraisers as Array<any>) ?? [];
const entry = entries.find((f) => f.id === slug);
const goal: number = Number(entry?.goal) || 0;
const pledged: number = Number(entry?.pledged) || 0;
const pct = goal > 0 ? Math.min(100, (pledged / goal) * 100) : 0;
const fmt = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: n % 1 ? 2 : 0 });
const t = (obj: any): string => obj?.[lang] || obj?.en || '';
---
{(entry && goal > 0) && (
  <section class="my-6 rounded-xl border border-line bg-muted p-5 text-center" aria-label={t(entry.title)}>
    <p class="my-1 text-sm font-bold uppercase tracking-widest text-soft">{ui.pledgedAsOf} {entry.updated}</p>
    <p class="my-1 font-serif text-4xl font-bold text-navy">{fmt(pledged)}</p>
    <div class="mx-auto my-3 h-5 max-w-xl overflow-hidden rounded-full bg-white" role="progressbar"
         aria-valuenow={Math.round(pct * 100) / 100} aria-valuemin={0} aria-valuemax={100}
         aria-label={`${fmt(pledged)} ${ui.ofWord} ${fmt(goal)} ${ui.goalWord}`}>
      <div class="h-full rounded-full" style={`width:${pct}%;background:linear-gradient(90deg,#a8861c,#c9a227)`}></div>
    </div>
    <p class="my-1 font-bold text-navy">{pct.toFixed(2)}% {ui.ofWord} {fmt(goal)} {ui.goalWord}</p>
    {entry.donate_link?.trim() ? (
      <p><a class="btn btn-gold" href={entry.donate_link.trim()}>{t(entry.donate_label) || ui.nav.giving}</a></p>
    ) : null}
  </section>
)}
