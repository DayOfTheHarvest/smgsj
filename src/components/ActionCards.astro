---
import actionsData from '../data/actions.json';
import BulletinList from './BulletinList.astro';
import Icon from './Icon.astro';
import { resolveLink, type Lang } from '../config';
interface Props { lang: Lang; ui: any; }
const { lang, ui } = Astro.props;
const cards = ((actionsData as any).cards as Array<any>) ?? [];
const btnClass = (s: string) =>
  s === 'gold' ? 'btn btn-gold' : s === 'outline' ? 'btn btn-outline' : 'btn btn-primary';
const hrefFor = (link: string) => resolveLink(link, lang);
---
<div class="cards four">
  {cards.map((c) => (
    <article class="card">
      {c.icon ? <div class="card-head"><Icon name={c.icon} /><h2>{c.title?.[lang] || c.title?.en}</h2></div> : <h2>{c.title?.[lang] || c.title?.en}</h2>}
      {c.kind === 'bulletins' ? (
        <BulletinList ui={ui} limit={5} />
      ) : (
        <>
          {(c.text?.[lang] || c.text?.en) && <p>{c.text?.[lang] || c.text?.en}</p>}
          {c.kind === 'link' && c.link?.trim() ? (
            <p><a class={btnClass(c.style)} href={hrefFor(c.link.trim())}>{c.link_label?.[lang] || c.link_label?.en || c.title?.[lang] || c.title?.en}</a></p>
          ) : null}
          {c.extra_link?.trim() ? (
            <p><a href={hrefFor(c.extra_link.trim())}>{c.extra_label?.[lang] || c.extra_label?.en}</a></p>
          ) : null}
        </>
      )}
    </article>
  ))}
</div>
